# Smart-AP-Suite PoC — LOCAL TEST VALUES ONLY (public repository, DEC-028). Copy to .env.
# Hosts are for running the apps on your machine; compose.yaml overrides them inside Docker.

POSTGRES_USER=saps
POSTGRES_PASSWORD=saps-local
POSTGRES_DB=saps
DATABASE_URL=postgresql+psycopg://saps:saps-local@localhost:5432/saps
# Database roles of SAPS-41 (row-level security): passwords set by the migration, URLs used by the API, worker and sweeper.
APP_DB_PASSWORD=saps-app-local
SYSTEM_DB_PASSWORD=saps-system-local
APP_DATABASE_URL=postgresql+psycopg://saps_app:saps-app-local@localhost:5432/saps
SYSTEM_DATABASE_URL=postgresql+psycopg://saps_system:saps-system-local@localhost:5432/saps

# Keycloak (SAPS-43): data in the database `keycloak`; the admin console is at KEYCLOAK_PUBLIC_URL.
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_DB_PASSWORD=keycloak-local
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin-local
KEYCLOAK_CLIENT_SECRET=saps-web-local-secret

REDIS_URL=redis://localhost:6379/0
DRAMATIQ_HEARTBEAT_TIMEOUT_MS=30000
DRAMATIQ_MAINTENANCE_CHANCE=100000
ACTOR_TIME_LIMIT_MS=60000
PROCESS_INVOICE_MAX_RETRIES=5
PROCESS_INVOICE_MIN_BACKOFF_MS=15000
PROCESS_INVOICE_MAX_BACKOFF_MS=300000
SWEEPER_INTERVAL_SECONDS=10
SWEEPER_STUCK_AFTER_SECONDS=60
SWEEPER_MAX_RESENDS=3

S3_ENDPOINT_URL=http://localhost:8333
S3_BUCKET=invoices
S3_ACCESS_KEY=local-test-access
S3_SECRET_KEY=local-test-secret

EXTRACTION_ADAPTER=dummy
ERP_ADAPTER=dummy
FIXTURES_DIR=fixtures

WEB_APP_ORIGIN=http://localhost:5173
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=8
# Local HTTP only; must be true whenever the stack is served over HTTPS (ADR-0008).
SESSION_COOKIE_SECURE=false
# Encrypts the stored Keycloak tokens and the sign-in cookie (SAPS-44). Generate your own:
#   openssl rand -base64 32 | tr '+/' '-_'
SESSION_ENCRYPTION_KEY=

MAX_UPLOAD_SIZE_MB=10
LOG_LEVEL=INFO

# Set your own value locally: the password of the demo users in Keycloak (SAPS-43). Empty → no demo seed.
SEED_USER_PASSWORD=
