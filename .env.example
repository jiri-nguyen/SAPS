# Smart-AP-Suite PoC — LOCAL TEST VALUES ONLY (public repository, DEC-028). Copy to .env.
# Hosts are for running the apps on your machine; compose.yaml overrides them inside Docker.

POSTGRES_USER=saps
POSTGRES_PASSWORD=saps-local
POSTGRES_DB=saps
DATABASE_URL=postgresql+psycopg://saps:saps-local@localhost:5432/saps

REDIS_URL=redis://localhost:6379/0
DRAMATIQ_HEARTBEAT_TIMEOUT_MS=30000
DRAMATIQ_MAINTENANCE_CHANCE=100000
ACTOR_TIME_LIMIT_MS=60000
SWEEPER_INTERVAL_SECONDS=10
SWEEPER_STUCK_AFTER_SECONDS=60

S3_ENDPOINT_URL=http://localhost:8333
S3_BUCKET=invoices
S3_ACCESS_KEY=local-test-access
S3_SECRET_KEY=local-test-secret

EXTRACTION_ADAPTER=dummy
ERP_ADAPTER=dummy
FIXTURES_DIR=fixtures

WEB_APP_ORIGIN=http://localhost:5173
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=8
# Local HTTP only; must be true whenever the stack is served over HTTPS (ADR-0008).
SESSION_COOKIE_SECURE=false

MAX_UPLOAD_SIZE_MB=10
LOG_LEVEL=INFO

# Set your own value locally; used by the seed of demo users (SAPS-27).
SEED_USER_PASSWORD=
